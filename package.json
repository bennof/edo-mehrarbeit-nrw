{
  "name": "edo-mehrarbeit-nrw",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Erfassung von Mehrarbeit für Lehrkräfte in NRW und Ausfüllen der LBV-Änderungsmitteilung",
  "license": "MIT",
  "author": "Benjamin Benno Falkner",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "commit-version": "node scripts/commit-version.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "uqr": "^0.1.3"
  }
}
