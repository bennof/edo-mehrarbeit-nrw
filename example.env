# Kopie als .env anlegen (wird nicht eingecheckt) und Werte eintragen.

# Port des Dev-Servers (`npm run dev`); ohne Angabe 5173
DEV_PORT=5173

# Google-Drive-Sicherung: nur die öffentliche Client-ID wird in den Build übernommen.
EDO_GOOGLE_CLIENT_ID=deine-client-id.apps.googleusercontent.com
EDO_GOOGLE_CLIENT_SECRET=dein-client-secret

# Impressum, Datenschutz, Nutzungsbedingungen (legal/*.html → privacy.html, impress.html, terms.html)
# Pflicht (fehlt einer dieser Werte, werden die Seiten nicht erzeugt):
EDO_LEGAL_NAME="Vorname Nachname"
EDO_LEGAL_STREET="Musterstraße 1"
EDO_LEGAL_ZIP_CITY="12345 Musterstadt"
EDO_LEGAL_EMAIL=kontakt@example.org
# Optional (leer = Angabe entfällt):
EDO_LEGAL_PHONE=
EDO_LEGAL_HOSTING="Name des Hosting-Anbieters"
EDO_LEGAL_LOG_RETENTION="7 Tage"
EDO_LEGAL_JURISDICTION=

# Optional: Stammdaten-Vorbelegung im Dev-Server, siehe README (z. B. SCHULNUMMER, DIENSTSTELLE, …)
